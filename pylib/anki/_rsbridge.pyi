from typing import Union

class Backend:
    @classmethod
    def command(cls, service: int, method: int, data: bytes) -> bytes: ...
    def db_command(self, data: bytes) -> bytes: ...

def buildhash() -> str: ...
def open_backend(data: bytes) -> Backend: ...
def initialize_logging(log_file: Union[str, None]) -> Backend: ...
def syncserver() -> None: ...
def new_webengine_profile() -> int: ...

class MediaServer:
    port: int
    host: str
    def __init__(
        self,
        host: str,
        port: int,
        web_root: str,
        addons_root: str,
        python: object,
        allow_any_host: bool = False,
    ) -> None: ...
    def set_csp(
        self,
        trusted_page: str,
        untrusted_media: str,
        legacy_editor: str,
        untrusted_sveltekit: str,
    ) -> None: ...
    def set_media_dir(self, path: str | None = None) -> None: ...
    def set_filter_media_paths(self, enabled: bool) -> None: ...
    def set_python_routes(self, enabled: bool) -> None: ...
    def set_web_exports(self, addon: str, pattern: str | None = None) -> bool: ...
    def set_page(self, id: int, html: str, context: int) -> None: ...
    def clear_page(self, id: int) -> None: ...
    def shutdown(self) -> None: ...
    def allow_framing_once(self, token: str) -> None: ...
